import java.util.*;
import java.util.stream.Collectors;

class Student {
    String name;
    double marks;

    public Student(String name, double marks) {
        this.name = name;
        this.marks = marks;
    }

    public String getName() {
        return name;
    }

    public double getMarks() {
        return marks;
    }

    @Override
    public String toString() {
        return name + " - Marks: " + marks;
    }
}

public class StudentFilter {
    public static void main(String[] args) {
        List<Student> students = Arrays.asList(
            new Student("Alice", 82.5),
            new Student("Bob", 65.0),
            new Student("Charlie", 78.0),
            new Student("David", 90.2),
            new Student("Emma", 72.3)
        );

        // Filtering students scoring above 75%, sorting by marks in descending order, and printing names
        List<String> topStudents = students.stream()
            .filter(s -> s.getMarks() > 75)  // Filter students with marks > 75
            .sorted(Comparator.comparingDouble(Student::getMarks).reversed())  // Sort by marks (Descending)
            .map(Student::getName)  // Extract names
            .collect(Collectors.toList()); // Collect names into a list

        // Displaying top students
        System.out.println("Students scoring above 75% sorted by marks:");
        topStudents.forEach(System.out::println);
    }
}

